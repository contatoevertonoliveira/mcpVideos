APP_ENV=development

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/mcp_videos
REDIS_URL=redis://redis:6379/0

CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=mcp-videos-local
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_USE_PATH_STYLE=true

SECRET_KEY=change-me-in-env

LOG_LEVEL=INFO

CORS_ALLOW_ORIGINS=["http://localhost:3000"]

# Fase 04 - YouTube OAuth. Key below is a valid Fernet key generated for
# local dev only - regenerate for staging/production (never reuse this one).
TOKEN_ENCRYPTION_KEY=X4J5J7m8wvFPwDzElZ9yQuam8wyuBS0civoPSxYMtNo=
# true = use FakeYouTubeGateway (no real Google account needed).
# Set to false once you have real Google Cloud OAuth credentials below.
YOUTUBE_FAKE_GATEWAY=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/youtube/callback

# Fase 06 - Channel Intelligence.
# true = use FakeLLMGateway (no real Anthropic API key needed).
# Set to false once you have a real ANTHROPIC_API_KEY below.
LLM_FAKE_GATEWAY=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-5-20250929
