# Root .env — used by docker-compose.yml for ${VAR:-default} substitution.
# Copy to .env and adjust if you need non-default ports/credentials for local dev.
# Real per-service configuration lives in apps/api/.env.example and apps/web/.env.example.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mcp_videos
POSTGRES_PORT=5432

REDIS_PORT=6379

STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET=mcp-videos-local
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

API_PORT=8002
WEB_PORT=3000

SECRET_KEY=change-me-in-env
